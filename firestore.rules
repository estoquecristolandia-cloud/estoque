rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'estoquecristolandia@gmail.com' ||
        request.auth.token.email.lower() == 'admin@app.local' ||
        request.auth.token.email.lower() == 'marconi@app.local' ||
        request.auth.token.email.lower() == 'marconi.cristolandia@gmail.com' ||
        request.auth.token.email.lower().matches('^admin@.*') ||
        request.auth.token.email.lower().matches('^marconi@.*')
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /kits/{kitId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /meals/{mealId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /missionaries/{missionaryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /inventory_audits/{auditId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /inventory_sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

