rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Único administrador autorizado: estoquecristolandia@gmail.com (admin@app.local removido permanentemente)
    function isAdmin() {
      return signedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'estoquecristolandia@gmail.com';
    }

    // Função de verificação na Whitelist de visualizadores autorizados
    function isAuthorizedViewer() {
      return signedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower())).data.active == true;
    }

    // Permissão de leitura operacional: Restrita ao Administrador ou Visualizador Ativo na Whitelist
    function canReadOperational() {
      return isAdmin() || isAuthorizedViewer();
    }

    // Proteção Cirúrgica do Marco Zero (21/08/2026 Alimentação e 21/09/2026 DML):
    // Impede alteração e exclusão da sessão oficial, auditorias e movimentações de implantação vinculadas.
    function isMarcoZeroSession(sessionId) {
      return sessionId == 'marco-zero-20260821' || sessionId == 'marco-zero-dml-20260921';
    }

    function isMarcoZeroRecord(id) {
      return id.matches('^adj-marco-zero-20260821-.*') || id.matches('^adj-20260821-.*') || id.matches('^adj-marco-zero-dml-20260921-.*');
    }

    // Coleção /authorized_users (Lista de Pré-Autorização):
    // - Visualizador consulta apenas o próprio documento pelo e-mail
    // - Listagem, criação, edição e revogação exclusivas do Administrador
    match /authorized_users/{userEmail} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == userEmail.lower());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Coleção /users (Perfis técnicos): Autocadastro público fechado; gestão exclusiva do Admin
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Coleções Operacionais: Blindagem Total — apenas Admin e Visualizadores Pré-Autorizados
    match /products/{productId} {
      allow read: if canReadOperational();
      allow create, update, delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow read: if canReadOperational();
      allow create: if isAdmin();
      allow update: if isAdmin() && !isMarcoZeroRecord(movementId);
      allow delete: if isAdmin() && !isMarcoZeroRecord(movementId);
    }

    match /kits/{kitId} {
      allow read: if canReadOperational();
      allow create, update, delete: if isAdmin();
    }

    match /meals/{mealId} {
      allow read: if canReadOperational();
      allow create, update, delete: if isAdmin();
    }

    match /missionaries/{missionaryId} {
      allow read: if canReadOperational();
      allow create, update, delete: if isAdmin();
    }

    match /inventory_audits/{auditId} {
      allow read: if canReadOperational();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && !isMarcoZeroRecord(auditId);
    }

    match /inventory_sessions/{sessionId} {
      allow read: if canReadOperational();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && !isMarcoZeroSession(sessionId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

